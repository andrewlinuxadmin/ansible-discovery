# flake8 configuration for Ansible Discovery project

[flake8]
max-line-length = 120
ignore = E501,E203,E402,W503,W504

exclude =
    __pycache__,
    .git,
    .venv,
    venv,
    .tox,
    dist,
    build,
    *.egg,
    collections

per-file-ignores =
    playbooks/library/*.py:E501
    scripts/*.py:E501
